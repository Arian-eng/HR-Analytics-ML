{
  "dataset": "job_change",
  "model": "Linear SVM",
  "estimator": "LinearSVC",
  "parameters": {
    "C": 0.1,
    "class_weight": "balanced",
    "dual": "auto",
    "fit_intercept": true,
    "intercept_scaling": 1,
    "loss": "squared_hinge",
    "max_iter": 20000,
    "multi_class": "ovr",
    "penalty": "l2",
    "random_state": 42,
    "tol": 0.0001,
    "verbose": 0
  },
  "iterations": 7
}